# ============================================================================
# SentricS2 Backend Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# For GCP deployment, use Secret Manager for sensitive values

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="SentricS2"
APP_VERSION="2.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# Security & Authentication
# ============================================================================
# CRITICAL: Generate a secure secret key for production
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="your-super-secret-key-here-change-this-in-production"
JWT_SECRET_KEY="your-jwt-secret-key-here"  # Used by GCP Cloud Run
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"
BCRYPT_ROUNDS=12

# ============================================================================
# Database Configuration
# ============================================================================
# Local Development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentrics2"

# GCP Cloud SQL (Production)
# Format: postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
# DATABASE_URL="postgresql://sentrics2:YOUR_PASSWORD@/sentrics2?host=/cloudsql/your-project:us-central1:sentrics2-db"

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# ============================================================================
# Redis Configuration
# ============================================================================
# Local Development
REDIS_URL="redis://localhost:6379/0"

# GCP Memorystore (Production)
# REDIS_URL="redis://10.0.0.3:6379/0"

DISABLE_REDIS=false

# ============================================================================
# CORS & Security
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Production CORS Origins (add your domains)
# CORS_ORIGINS="https://sentrics2.com,https://app.sentrics2.com,https://your-project.web.app"

# Comma-separated list of allowed hosts (or * for all)
ALLOWED_HOSTS="localhost,127.0.0.1"
# ALLOWED_HOSTS="sentrics2.com,api.sentrics2.com,*.run.app"

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=200
DISABLE_RATE_LIMIT=false

# ============================================================================
# GCP Configuration
# ============================================================================
# Your GCP Project ID
GCP_PROJECT_ID="your-gcp-project-id"

# GCP Region
GCP_REGION="us-central1"

# Cloud Run Service Name
GCP_SERVICE_NAME="sentrics2-api"

# Frontend URL (for CORS)
FRONTEND_URL="https://your-project.web.app"

# GCP Storage Bucket
# GCP_STORAGE_BUCKET="your-project-documents"

# ============================================================================
# Multi-Tenant Configuration
# ============================================================================
ENABLE_MULTI_TENANT=true
DEFAULT_TENANT_ID="demo"
MAX_USERS_PER_TENANT=100
TENANT_ISOLATION_MODE="strict"  # strict, shared, hybrid

# ============================================================================
# File Upload
# ============================================================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="./uploads"

# For GCP, use Cloud Storage
# UPLOAD_DIR="/tmp"  # Cloud Run has ephemeral storage

# ============================================================================
# AI/ML Configuration (Optional)
# ============================================================================
# Google Gemini API Key (for AI features)
# GOOGLE_GEMINI_API_KEY="your-gemini-api-key"

# OpenAI API Key (if using OpenAI)
# OPENAI_API_KEY="your-openai-api-key"

# ============================================================================
# External Services (Optional)
# ============================================================================
# Email Configuration (for notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@sentrics2.com"

# Sentry (Error Tracking)
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ============================================================================
# Feature Flags
# ============================================================================
DISABLE_QDRANT=true  # Vector database (optional)

# ============================================================================
# API Configuration
# ============================================================================
API_V1_STR="/api/v1"
API_V1_PREFIX="/api/v1"

# ============================================================================
# Geographic Configuration
# ============================================================================
DEFAULT_SRID=4326  # WGS84 coordinate system

# ============================================================================
# Monitoring & Observability (GCP)
# ============================================================================
# Enable Cloud Logging
# GCP_LOGGING_ENABLED=true

# Enable Cloud Monitoring
# GCP_MONITORING_ENABLED=true

# ============================================================================
# Notes for GCP Deployment
# ============================================================================
# 1. Store sensitive values in Secret Manager:
#    - SECRET_KEY
#    - JWT_SECRET_KEY
#    - DATABASE_URL
#    - REDIS_URL
#    - API keys
#
# 2. Use Cloud SQL Proxy for database connections
# 3. Use Memorystore for Redis
# 4. Use Cloud Storage for file uploads
# 5. Use Cloud Logging for centralized logs
# 6. Set ENVIRONMENT=production for production deployments
#
# Example Cloud Run deployment command:
# gcloud run deploy sentrics2-api \
#   --source . \
#   --region us-central1 \
#   --allow-unauthenticated \
#   --set-env-vars ENVIRONMENT=production \
#   --set-secrets DATABASE_URL=sentrics2-db-url:latest,SECRET_KEY=sentrics2-secret-key:latest
