# ============================================================================
# SentricS2 Frontend Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# API Configuration
# ============================================================================
# Backend API URL
VITE_API_URL="http://localhost:8000"

# Production API URL (uncomment for production)
# VITE_API_URL="https://api.sentrics2.com"
# VITE_API_URL="https://sentrics2-api-xxx-uc.a.run.app"  # GCP Cloud Run

# API Version
VITE_API_VERSION="v1"

# ============================================================================
# Application Configuration
# ============================================================================
VITE_APP_NAME="SentricS2"
VITE_APP_VERSION="2.0.0"
VITE_ENVIRONMENT="development"  # development, staging, production

# ============================================================================
# Authentication
# ============================================================================
# Token storage key
VITE_AUTH_TOKEN_KEY="sentrics2_auth_token"

# Session timeout (minutes)
VITE_SESSION_TIMEOUT=30

# ============================================================================
# Feature Flags
# ============================================================================
# Enable/disable features
VITE_FEATURE_CER_ENABLED=true
VITE_FEATURE_VISUAL_DESIGNER_ENABLED=true
VITE_FEATURE_AI_ASSISTANT_ENABLED=false
VITE_FEATURE_ANALYTICS_ENABLED=true

# ============================================================================
# Maps Configuration
# ============================================================================
# Leaflet/OpenStreetMap configuration
VITE_MAP_DEFAULT_CENTER="41.9028,12.4964"  # Rome, Italy
VITE_MAP_DEFAULT_ZOOM=6
VITE_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Optional: MapBox API Key (for better maps)
# VITE_MAPBOX_API_KEY="your-mapbox-api-key"

# ============================================================================
# Analytics & Monitoring
# ============================================================================
# Google Analytics (optional)
# VITE_GA_TRACKING_ID="G-XXXXXXXXXX"

# Sentry (Error Tracking)
# VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ============================================================================
# External Services
# ============================================================================
# Google Gemini API Key (for client-side AI features, if any)
# VITE_GOOGLE_GEMINI_API_KEY="your-gemini-api-key"

# ============================================================================
# Build Configuration
# ============================================================================
# Enable source maps in production (useful for debugging)
VITE_SOURCEMAP=false

# ============================================================================
# GCP Firebase Hosting Configuration
# ============================================================================
# If deploying to Firebase Hosting
# VITE_FIREBASE_API_KEY="your-firebase-api-key"
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
# VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"

# ============================================================================
# Internationalization
# ============================================================================
VITE_DEFAULT_LANGUAGE="it"  # Italian by default
VITE_SUPPORTED_LANGUAGES="it,en"

# ============================================================================
# UI Configuration
# ============================================================================
# Theme
VITE_DEFAULT_THEME="light"  # light or dark

# Items per page in tables
VITE_DEFAULT_PAGE_SIZE=20

# ============================================================================
# Development Configuration
# ============================================================================
# Enable mock data for development
VITE_USE_MOCK_DATA=false

# Enable debug mode (shows extra logs in console)
VITE_DEBUG=false

# ============================================================================
# Notes for GCP Deployment
# ============================================================================
# 1. For Firebase Hosting:
#    - Update VITE_API_URL to point to your Cloud Run backend
#    - Configure CORS in backend to allow Firebase Hosting domains
#    - Run: npm run build && firebase deploy
#
# 2. For Cloud Storage + Load Balancer:
#    - Build: npm run build
#    - Upload to Cloud Storage bucket
#    - Configure Cloud CDN for better performance
#
# 3. Environment-specific builds:
#    - Create .env.development.local for local development
#    - Create .env.production for production builds
#    - Vite will automatically load the correct file
#
# 4. Build commands:
#    - Development: npm run dev
#    - Production: npm run build
#    - Preview: npm run preview
